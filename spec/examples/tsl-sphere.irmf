// A single 10mm-diameter sphere.
const sphere = Fn(([radius, p]) => {
  return select(length(p).lessThanEqual(radius), float(1.0), float(0.0));
});

const mainModel4 = Fn(([xyz]) => {
  return [sphere(float(5.0), xyz)]; // one value per material
});
