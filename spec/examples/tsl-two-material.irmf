  "materials": ["core", "shell"],
  "max": [5,5,5],
  "min": [-5,-5,-5],
  "units": "mm",
  "title": "tsl two-material sphere",
  "version": "1.0"
}*/

// A solid core surrounded by a shell.
const ball = (radius, p) => {
  return select(length(p).lessThanEqual(radius), float(1.0), float(0.0));
};

const mainModel4 = (xyz) => [
  ball(float(2.5), xyz), // core
  ball(float(5.0), xyz), // shell (includes the core for simplicity)
];
